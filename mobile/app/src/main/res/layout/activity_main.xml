<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root_scroll"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#08090B"
    android:fillViewport="true">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="22dp"
        android:paddingEnd="22dp"
        android:paddingTop="28dp"
        android:paddingBottom="28dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="VDO STUDIO"
            android:textColor="#F2F4F7"
            android:textSize="26sp"
            android:textStyle="bold" />
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="OFFLINE DOCUMENTARY DIRECTOR"
            android:textColor="#929AA6"
            android:textSize="11sp"
            android:letterSpacing="0.08" />

        <TextView
            android:id="@+id/status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:background="#111318"
            android:padding="12dp"
            android:text="LOCAL ENGINE · initializing"
            android:textColor="#D8DEE8"
            android:textSize="12sp" />

        <Button
            android:id="@+id/import_model"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Import GGUF model"
            android:textAllCaps="false" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:text="YOUR FILM IDEA"
            android:textColor="#A3AAB5"
            android:textSize="11sp"
            android:textStyle="bold" />
        <EditText
            android:id="@+id/brief_input"
            android:layout_width="match_parent"
            android:layout_height="144dp"
            android:layout_marginTop="8dp"
            android:background="#111318"
            android:gravity="top|start"
            android:hint="Describe your documentary or film in one message…"
            android:inputType="textMultiLine|textCapSentences"
            android:padding="14dp"
            android:textColor="#F2F4F7"
            android:textColorHint="#727A86"
            android:textSize="14sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="TARGET EDITOR"
            android:textColor="#A3AAB5"
            android:textSize="11sp"
            android:textStyle="bold" />
        <Spinner
            android:id="@+id/editor_spinner"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="4dp"
            android:background="#111318" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="COLOR INTENT"
            android:textColor="#A3AAB5"
            android:textSize="11sp"
            android:textStyle="bold" />
        <Spinner
            android:id="@+id/look_spinner"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="4dp"
            android:background="#111318" />

        <Button
            android:id="@+id/generate_plan"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="Generate offline plan"
            android:textAllCaps="false" />

        <Button
            android:id="@+id/save_plan"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Save plan to device"
            android:textAllCaps="false" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="LOCAL MODEL OUTPUT"
            android:textColor="#A3AAB5"
            android:textSize="11sp"
            android:textStyle="bold" />
        <TextView
            android:id="@+id/output"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="#111318"
            android:padding="14dp"
            android:text="Import a compatible chat/instruct GGUF file to begin. No cloud account or internet permission is used."
            android:textColor="#F2F4F7"
            android:textIsSelectable="true"
            android:textSize="14sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="Offline generation · your GGUF model stays on this phone"
            android:textColor="#727A86"
            android:textSize="11sp" />
    </LinearLayout>
</ScrollView>
