VDO_OUTPUT_DIR=./outputs
VDO_OLLAMA_URL=http://127.0.0.1:11434
VDO_OLLAMA_MODEL=qwen3:8b

# Quality-first natural neural voice
VDO_TTS_PROVIDER=auto
VDO_QWEN3_MODEL=auto
VDO_QWEN3_VOICE=Aiden
VDO_QWEN3_LANG=English
VDO_QWEN3_DEVICE=auto
VDO_TTS_STRICT=0
VDO_ALLOW_PIPER_FALLBACK=0
VDO_KOKORO_VOICE=af_heart
VDO_KOKORO_LANG=a
VDO_PIPER_MODEL=en_US-lessac-medium
VDO_PIPER_DATA_DIR=./models

VDO_WHISPER_MODEL=base
VDO_WHISPER_DEVICE=cpu
VDO_WHISPER_COMPUTE_TYPE=int8

VDO_CINEMATIC=1
VDO_SHOW_SCENE_TITLES=0
VDO_TRANSITION_SECONDS=0.35
VDO_MUSIC_LEVEL=0.11

VDO_WORKERS=6
VDO_MEDIA_WORKERS=8
VDO_FPS=30
VDO_WIDTH=1920
VDO_HEIGHT=1080
VDO_REQUEST_TIMEOUT=45

# Optional: use a voice you own or are authorized to reproduce
# VDO_TTS_PROVIDER=qwen3-clone
# VDO_VOICE_REFERENCE=./path/to/narrator.wav
# VDO_VOICE_REFERENCE_TEXT="Transcript of the reference clip"

VDO_REAL_FOOTAGE_FIRST=1
VDO_CINEMATIC_GRAIN=0.45
VDO_VIDEO_CRF=18
VDO_X264_PRESET=medium
VDO_AUDIO_BITRATE=256k
